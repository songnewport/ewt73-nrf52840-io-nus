#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/*
 * EWT73-TBCE / E73-2G4M08S1C BLE review-build overlay.
 *
 * Keep the hardware facts proven on the bench:
 *   SW3 / P0.20 = pairing button
 *   P0.06 = nRF TX -> STM32 PA3 (USART2_RX)
 *   P0.08 = nRF RX <- STM32 PA2 (USART2_TX)
 */

/ {
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
	};

	aliases {
		led0 = &ewt_led0;
		led1 = &ewt_led1;
		led2 = &ewt_led2;
		sw0 = &sw3_pair_button;
		sw1 = &sw1_button;
		sw2 = &sw4_button;
	};

	ewt_leds {
		compatible = "gpio-leds";

		ewt_led0: led_0 {
			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
			label = "EWT73 LED P0.12";
		};

		ewt_led1: led_1 {
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			label = "EWT73 LED P0.04";
		};

		ewt_led2: led_2 {
			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
			label = "EWT73 LED P1.09";
		};
	};

	buttons {
		compatible = "gpio-keys";

		sw1_button: sw1_button {
			gpios = <&gpio0 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW1_BUTTON";
		};

		sw3_pair_button: sw3_pair_button {
			gpios = <&gpio0 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW3_PAIR_BUTTON";
		};

		sw4_button: sw4_button {
			gpios = <&gpio0 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW4_BUTTON";
		};
	};
};

&pinctrl {
	i2c0_ina228: i2c0_ina228 {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
				<NRF_PSEL(TWIM_SCL, 1, 10)>;
		};
	};

	i2c0_ina228_sleep: i2c0_ina228_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
				<NRF_PSEL(TWIM_SCL, 1, 10)>;
			low-power-enable;
		};
	};

	uart0_stm32: uart0_stm32 {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 8)>;
			bias-pull-up;
		};
	};

	uart0_stm32_sleep: uart0_stm32_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>,
				<NRF_PSEL(UART_RX, 0, 8)>;
			low-power-enable;
		};
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c0_ina228>;
	pinctrl-1 = <&i2c0_ina228_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	ina228: ina228@40 {
		compatible = "ti,ina228";
		reg = <0x40>;
		status = "okay";
		current-lsb-microamps = <19>;
		rshunt-micro-ohms = <15000>;
		avg-count = <16>;
	};
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart0_stm32>;
	pinctrl-1 = <&uart0_stm32_sleep>;
	pinctrl-names = "default", "sleep";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
	};
};
