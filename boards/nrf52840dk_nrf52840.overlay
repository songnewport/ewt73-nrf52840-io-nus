#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * EWT73-TBCE / E73-2G4M08S1C BLE baseline overlay.
 *
 * LEDs:
 *   P0.12, P0.04, P1.09, active low
 * ADC channels sample AIN1 and AIN4 using Zephyr's nRF SAADC driver.
 * INA228 I2C uses P1.11 SDA and P1.10 SCL.
 */

/ {
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
	};

	aliases {
		led0 = &ewt_led0;
		led1 = &ewt_led1;
		led2 = &ewt_led2;
		sw0 = &pair_button;
		sw1 = &sw3_button;
		sw2 = &sw4_button;
	};

	ewt_leds {
		compatible = "gpio-leds";

		ewt_led0: led_0 {
			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
			label = "EWT73 LED P0.12";
		};

		ewt_led1: led_1 {
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			label = "EWT73 LED P0.04";
		};

		ewt_led2: led_2 {
			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
			label = "EWT73 LED P1.09";
		};
	};

	buttons {
		compatible = "gpio-keys";

		pair_button: pair_button {
			gpios = <&gpio0 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "PAIR_BUTTON";
		};

		sw3_button: sw3_button {
			gpios = <&gpio0 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW3_BUTTON";
		};

		sw4_button: sw4_button {
			gpios = <&gpio0 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW4_BUTTON";
		};
	};
};

&pinctrl {
	i2c0_ina228: i2c0_ina228 {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
				<NRF_PSEL(TWIM_SCL, 1, 10)>;
		};
	};

	i2c0_ina228_sleep: i2c0_ina228_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
				<NRF_PSEL(TWIM_SCL, 1, 10)>;
			low-power-enable;
		};
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c0_ina228>;
	pinctrl-1 = <&i2c0_ina228_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	ina228: ina228@40 {
		reg = <0x40>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN1>; /* P0.03 */
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN4>; /* P0.28 */
		zephyr,resolution = <12>;
	};
};
